<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive data from cloud backup -->
        <exclude domain="sharedpref" path="user_credentials.xml" />
        <exclude domain="sharedpref" path="location_data.xml" />
        <exclude domain="database" path="trip_history.db" />
    </cloud-backup>
    <device-transfer>
        <!-- Allow device transfer of user data -->
        <include domain="sharedpref" path="app_settings.xml" />
        <include domain="sharedpref" path="user_preferences.xml" />
        <include domain="file" path="photos/" />
        <include domain="file" path="notes/" />
    </device-transfer>
</data-extraction-rules>
